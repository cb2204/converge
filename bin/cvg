#!/usr/bin/env bash
# cvg — the Converge CLI: one name over the proven task-spec toolchain.
#
# The referee, never a player: cvg frames, routes, and gates — it holds no
# model credentials and never calls an LLM. Wrapped subcommands are exact
# pass-throughs (same bytes, same exit code) to skills/task-spec/scripts/,
# so every already-proven gate stays proven (rule 3: wrap, don't rewrite).
#
# Resolution: CVG_HOME wins when set; otherwise walk up from the working
# directory to the first repo carrying skills/task-spec/scripts/.
#
# Task-Spec: tasks/done/T-20260719-cvg-router.md (Milestone 1.1, born at R0.I).
# Portability: macOS system bash 3.2.

set -euo pipefail

CVG_VERSION="0.14.0"

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=bin/_ui.sh
. "$BIN_DIR/_ui.sh"

# ---------------------------------------------------------------------------
# Locate the Converge home (the repo whose scripts we route to)
# ---------------------------------------------------------------------------
resolve_home() {
  if [ -n "${CVG_HOME:-}" ]; then
    if [ -d "$CVG_HOME/skills/task-spec/scripts" ]; then
      printf '%s\n' "$CVG_HOME"
      return 0
    fi
    ui_err "CVG_HOME is set but '$CVG_HOME/skills/task-spec/scripts' does not exist"
    return 1
  fi
  local dir="$PWD"
  while [ "$dir" != "/" ]; do
    if [ -d "$dir/skills/task-spec/scripts" ]; then
      printf '%s\n' "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  ui_err "no Converge home found walking up from '$PWD' — run inside a repo with skills/task-spec/scripts/, or set CVG_HOME"
  return 1
}

# route <script-name> [args...] — exact pass-through; exec keeps stdout and
# the exit code byte-identical to a direct invocation.
route() {
  local script="$1"
  shift
  exec bash "$SCRIPTS/$script" "$@"
}

# ---------------------------------------------------------------------------
# Non-secret project config (.cvg/config) — CHOICES, never CREDENTIALS.
# ---------------------------------------------------------------------------
# The referee holds no secrets: setup records which tracker to use (later:
# engine/index/memory) — never an API key. Secrets resolve at runtime from the
# environment (or a secrets manager); if cvg can't see them it can't leak them
# (the SOTA agent-secret posture — Claude Code / Cursor have both leaked .env
# keys by reading them). Format: plain KEY=value lines, greppable, bash-3.2-safe.
# Lives at <repo>/.cvg/config (committable; *.local is gitignored).
cvg_config_file() { printf '%s/.cvg/config\n' "$CVG_HOME_DIR"; }
cvg_config_get() {  # cvg_config_get KEY -> value on stdout (empty if unset)
  local f; f="$(cvg_config_file)"
  [ -f "$f" ] || return 0
  grep -m1 "^$1=" "$f" 2>/dev/null | cut -d= -f2- || true
}
cvg_config_set() {  # cvg_config_set KEY VALUE  (idempotent replace-or-append)
  local f tmp; f="$(cvg_config_file)"
  mkdir -p "$(dirname "$f")"
  tmp="$(mktemp)"
  if [ -f "$f" ]; then grep -v "^$1=" "$f" > "$tmp" 2>/dev/null || true; fi
  printf '%s=%s\n' "$1" "$2" >> "$tmp"
  mv "$tmp" "$f"
}

# Bridge the non-secret Linear team id from .cvg/config into the env the adapter
# reads, unless the user already set it. The API KEY is NEVER stored or bridged —
# it lives in the environment only. This is what lets `cvg register` work after
# setup with just the one secret exported.
# Bridge the recorded repo base URL into the env the renderer reads, so every
# registered issue links back to its spec. Non-secret, like the team id.
cvg_export_spec_base() {
  if [ -z "${TSI_SPEC_BASE_URL:-}" ]; then
    local u; u="$(cvg_config_get spec_base_url)"
    if [ -n "$u" ]; then export TSI_SPEC_BASE_URL="$u"; fi
  fi
  return 0   # bare-statement safe under set -e (see cvg_export_linear_team)
}

# Derive a browsable blob base (host/org/repo/blob/<branch>) from the git remote.
# Echoes empty when there is no remote to read.
cvg_detect_repo_base() {   # cvg_detect_repo_base [branch]
  local remote branch path host
  remote="$(git -C "$CVG_HOME_DIR" remote get-url origin 2>/dev/null || true)"
  [ -n "$remote" ] || return 0
  branch="${1:-}"
  if [ -z "$branch" ]; then
    branch="$(git -C "$CVG_HOME_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    [ -n "$branch" ] || branch="main"
  fi
  case "$remote" in
    git@*)        path="${remote#git@}"; path="${path/://}" ;;
    ssh://git@*)  path="${remote#ssh://git@}" ;;
    https://*)    path="${remote#https://}" ;;
    http://*)     path="${remote#http://}" ;;
    *)            path="$remote" ;;
  esac
  path="${path%.git}"
  host="${path%%/*}"
  # Blob paths differ per host; GitHub's shape is the default.
  case "$host" in
    *gitlab*)    printf 'https://%s/-/blob/%s' "$path" "$branch" ;;
    *bitbucket*) printf 'https://%s/src/%s' "$path" "$branch" ;;
    *)           printf 'https://%s/blob/%s' "$path" "$branch" ;;
  esac
}

cvg_setup_repo() {
  local url="" branch=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --url)      url="${2:-}"; shift 2 ;;
      --url=*)    url="${1#--url=}"; shift ;;
      --branch)   branch="${2:-}"; shift 2 ;;
      --branch=*) branch="${1#--branch=}"; shift ;;
      -*) ui_err "unknown flag '$1' (expected: --url <base> | --branch <name>)"
          printf 'SETUP_REPO=USAGE_ERROR\n'; exit 2 ;;
      *)  shift ;;
    esac
  done
  [ -n "$url" ] || url="$(cvg_detect_repo_base "$branch")"
  if [ -z "$url" ]; then
    ui_err "no git remote to detect — pass it: cvg setup repo --url https://github.com/<org>/<repo>/blob/main"
    printf 'SETUP_REPO=UNDETECTED\n'; exit 1
  fi
  cvg_config_set spec_base_url "$url"
  printf '%s[ok]%s repo linked: %s\n' "$UI_GREEN" "$UI_RESET" "$url"
  printf '%s     registered issues now link back to their spec (branch-pinned —\n' "$UI_DIM"
  printf '     re-run with --branch main once specs land there)%s\n' "$UI_RESET"
  printf 'SETUP_REPO=OK\n'
}

cvg_export_linear_team() {
  if [ -z "${LINEAR_TEAM_ID:-}" ]; then
    local tid; tid="$(cvg_config_get linear_team_id)"
    if [ -n "$tid" ]; then export LINEAR_TEAM_ID="$tid"; fi
  fi
  # MUST return 0: this is called as a bare statement under `set -e`, so a falsy
  # trailing test would abort the whole command (it did — caught in review).
  return 0
}

# ---------------------------------------------------------------------------
# setup — the guided connectivity surface (a generalized doctor + config).
# ---------------------------------------------------------------------------
# `cvg setup` scans every moving part and reports readiness + the exact next
# step; `cvg setup tracker <t>` validates a backend and records the CHOICE.
# Model: fly doctor + stripe projects status + clanker onboarding scan.
_cvg_tracker_adapter() { printf '%s/skills/task-specs-to-issues/scripts/adapters/%s.sh\n' "$CVG_HOME_DIR" "$1"; }

cvg_setup_status() {
  printf '%scvg setup%s %s— connectivity status%s\n' "$UI_BOLD" "$UI_RESET" "$UI_DIM" "$UI_RESET"
  ui_rule
  local ready=1

  # engines (Pass-4 workers) — reuse the doctor's verdict.
  local doc
  doc="$(bash "$CVG_HOME_DIR/skills/sketch-plans-adversarial-review/scripts/doctor.sh" 2>/dev/null | grep -m1 '^DOCTOR=' || true)"
  if [ "$doc" = "DOCTOR=OK" ]; then
    printf '  %s[ok]%s  engines   Pass-4 adversaries ready\n' "$UI_GREEN" "$UI_RESET"
  else
    printf '  %s[--]%s  engines   not ready — run: cvg setup engines\n' "$UI_YELLOW" "$UI_RESET"; ready=0
  fi

  # trackers — preflight each; mark the configured default.
  local cfg; cfg="$(cvg_config_get tracker)"
  printf '  trackers  %sdefault: %s%s\n' "$UI_DIM" "${cfg:-<none — cvg setup tracker linear>}" "$UI_RESET"
  cvg_export_linear_team   # so a configured Linear team makes its preflight pass
  local t ad marker tracker_ok=0
  for t in linear github jira; do
    ad="$(_cvg_tracker_adapter "$t")"
    [ -f "$ad" ] || continue
    marker=""
    if [ "$t" = "$cfg" ]; then marker="  (default)"; fi
    if bash "$ad" preflight >/dev/null 2>&1; then
      printf '    %s[ok]%s  %-7s connected%s\n' "$UI_GREEN" "$UI_RESET" "$t" "$marker"
      if [ "$t" = "$cfg" ]; then tracker_ok=1; fi
    else
      printf '    %s[--]%s  %-7s not connected — cvg setup tracker %s\n' "$UI_DIM" "$UI_RESET" "$t" "$t"
    fi
  done

  # repo link — the spec <-> tracker glue.
  local repo; repo="$(cvg_config_get spec_base_url)"
  if [ -n "$repo" ]; then
    printf '  %s[ok]%s  repo      %s\n' "$UI_GREEN" "$UI_RESET" "$repo"
  else
    printf '  %s[--]%s  repo      not linked — run: cvg setup repo\n' "$UI_DIM" "$UI_RESET"
  fi

  # planned areas (brownfield) — visible vision, honest status.
  printf '  %s[..]%s  index     codebase indexing (planned)\n' "$UI_DIM" "$UI_RESET"
  printf '  %s[..]%s  memory    context / memory store (planned)\n' "$UI_DIM" "$UI_RESET"
  ui_rule

  if [ "$ready" -eq 1 ] && [ "$tracker_ok" -eq 1 ]; then
    printf 'SETUP=READY\n'
  else
    if [ -z "$cfg" ]; then printf '%snext: cvg setup tracker linear%s\n' "$UI_DIM" "$UI_RESET"; fi
    printf 'SETUP=INCOMPLETE\n'
  fi
}

cvg_setup_tracker() {
  local t="" team_flag=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --team)   team_flag="${2:-}"; shift 2 ;;
      --team=*) team_flag="${1#--team=}"; shift ;;
      -*) ui_err "unknown flag '$1' (expected: --team <key>)"; printf 'SETUP_TRACKER=USAGE_ERROR\n'; exit 2 ;;
      *) [ -z "$t" ] && t="$1"; shift ;;
    esac
  done
  case "$t" in
    linear|github|jira) ;;
    fake) ;;  # test-only no-network backend (records tracker=fake for offline tests)
    "") ui_err "usage: cvg setup tracker <linear|github|jira> [--team <key>]"; printf 'SETUP_TRACKER=USAGE_ERROR\n'; exit 2 ;;
    *)  ui_err "unknown tracker '$t' — expected: linear | github | jira"; printf 'SETUP_TRACKER=USAGE_ERROR\n'; exit 2 ;;
  esac
  local ad; ad="$(_cvg_tracker_adapter "$t")"
  [ -f "$ad" ] || { ui_err "adapter not found: $ad"; printf 'SETUP_TRACKER=USAGE_ERROR\n'; exit 2; }

  # Linear has a team to discover; other trackers are a simple preflight + record.
  if [ "$t" = "linear" ]; then
    cvg_setup_tracker_linear "$ad" "$team_flag"
    return
  fi

  printf '%sconnecting %s …%s\n' "$UI_DIM" "$t" "$UI_RESET"
  if bash "$ad" preflight; then
    cvg_config_set tracker "$t"
    printf '%s[ok]%s recorded default tracker = %s in %s\n' "$UI_GREEN" "$UI_RESET" "$t" "$(cvg_config_file)"
    printf '%snext: cvg register --check   then   cvg register%s\n' "$UI_DIM" "$UI_RESET"
    printf 'SETUP_TRACKER=OK\n'
  else
    printf '%s[--]%s %s not reachable — export its credentials (shown above) and re-run.\n' "$UI_YELLOW" "$UI_RESET" "$t"
    printf '%snote: cvg never stores your key; it stays in your environment (or a secrets manager).%s\n' "$UI_DIM" "$UI_RESET"
    printf 'SETUP_TRACKER=UNREACHABLE\n'
    exit 1
  fi
}

# Linear connect: ONE secret (LINEAR_API_KEY). The team is auto-discovered — a
# single team auto-selects, several list for `--team <KEY>`, and the KEY (from the
# Linear URL) resolves to a UUID we record in .cvg/config. The key is never stored.
cvg_setup_tracker_linear() {
  local ad="$1" team_flag="$2"
  if [ -z "${LINEAR_API_KEY:-}" ]; then
    ui_err "LINEAR_API_KEY unset — create one at linear.app/settings/account/security, then: export LINEAR_API_KEY=lin_api_..."
    printf 'SETUP_TRACKER=UNREACHABLE\n'; exit 1
  fi
  printf '%sconnecting linear …%s\n' "$UI_DIM" "$UI_RESET"

  # Discover teams (key<TAB>name<TAB>uuid). The key already knows them.
  # Capture stderr instead of swallowing it: when this fails, the adapter's own
  # message (bad/revoked key, missing tool, GraphQL error) IS the diagnosis.
  local teams n errf
  errf="$(mktemp)"
  teams="$(bash "$ad" teams 2>"$errf" || true)"
  n="$(printf '%s' "$teams" | grep -c . || true)"; n="${n//[^0-9]/}"; n="${n:-0}"
  if [ "$n" -eq 0 ]; then
    ui_err "could not list any Linear teams. The adapter reported:"
    if [ -s "$errf" ]; then
      sed 's/^/    /' "$errf" >&2
    else
      printf '    (no error output — the API returned an empty team list)\n' >&2
    fi
    printf '%s    check: key valid + not revoked · key has Read access · key can see the team%s\n' "$UI_DIM" "$UI_RESET" >&2
    printf '%s    raw test: curl -s -X POST https://api.linear.app/graphql -H "Authorization: $LINEAR_API_KEY" -H "Content-Type: application/json" -d '"'"'{"query":"{ viewer { name email } }"}'"'"'%s\n' "$UI_DIM" "$UI_RESET" >&2
    rm -f "$errf"
    printf 'SETUP_TRACKER=UNREACHABLE\n'; exit 1
  fi
  rm -f "$errf"

  # Choose the team: --team wins; else the single team; else ask for --team <KEY>.
  local chosen="${team_flag:-${LINEAR_TEAM_ID:-}}"
  if [ -z "$chosen" ]; then
    if [ "$n" -eq 1 ]; then
      chosen="$(printf '%s' "$teams" | head -1 | cut -f1)"
      printf '%sone team found — auto-selecting %s%s\n' "$UI_DIM" "$chosen" "$UI_RESET"
    else
      printf '%s%s teams found — re-run with --team <KEY>:%s\n' "$UI_YELLOW" "$n" "$UI_RESET"
      printf '%s' "$teams" | awk -F'\t' '{printf "    %-8s %s\n", $1, $2}'
      printf 'SETUP_TRACKER=NEEDS_TEAM\n'; exit 1
    fi
  fi

  # Resolve the chosen key (or UUID) to its UUID from the discovered list.
  local uuid
  uuid="$(printf '%s' "$teams" | awk -F'\t' -v c="$chosen" 'toupper($1)==toupper(c) || $3==c {print $3; exit}')"
  if [ -z "$uuid" ]; then
    ui_err "team '$chosen' not found. Available: $(printf '%s' "$teams" | cut -f1 | paste -sd' ' -)"
    printf 'SETUP_TRACKER=NEEDS_TEAM\n'; exit 1
  fi

  # Validate end-to-end with the resolved UUID, then record (never the key).
  if LINEAR_TEAM_ID="$uuid" bash "$ad" preflight >/dev/null 2>&1; then
    cvg_config_set tracker linear
    cvg_config_set linear_team_id "$uuid"
    local name; name="$(printf '%s' "$teams" | awk -F'\t' -v u="$uuid" '$3==u {print $2; exit}')"
    printf '%s[ok]%s connected to Linear team %s%s\n' "$UI_GREEN" "$UI_RESET" "$chosen" "${name:+ ($name)}"
    printf '%s     recorded tracker=linear + team UUID in %s (API key stays in your env)%s\n' "$UI_DIM" "$(cvg_config_file)" "$UI_RESET"
    printf '%snext: cvg register --check   then   cvg register%s\n' "$UI_DIM" "$UI_RESET"
    printf 'SETUP_TRACKER=OK\n'
  else
    printf '%s[--]%s resolved team %s but preflight failed — check the key'\''s team access.\n' "$UI_YELLOW" "$UI_RESET" "$chosen"
    printf 'SETUP_TRACKER=UNREACHABLE\n'; exit 1
  fi
}

cmd_version() {
  local ts_ver
  ts_ver="$(grep -m1 '^TASKSPEC_VERSION=' "$SCRIPTS/_lib.sh" | cut -d'"' -f2)"
  printf 'cvg %s%s%s (task-spec %s)\n' "$UI_BOLD" "$CVG_VERSION" "$UI_RESET" "${ts_ver:-unknown}"
  printf '%shome: %s%s\n' "$UI_DIM" "$CVG_HOME_DIR" "$UI_RESET"
}

cmd_help() {
  printf '%scvg%s %s— the Converge referee%s  v%s\n' \
    "$UI_BOLD" "$UI_RESET" "$UI_DIM" "$UI_RESET" "$CVG_VERSION"
  ui_rule
  printf 'usage: cvg <command> [args]   %s(flags pass through verbatim)%s\n' "$UI_DIM" "$UI_RESET"
  printf '\n'
  printf '%spasses%s\n' "$UI_CYAN" "$UI_RESET"
  printf '  capture [--draft|--no-go] [brief]\n'
  printf '                           Pass 0 gate — finds cvg/docs/brd-*.md (then\n'
  printf '                           docs/) when no path is given\n'
  printf '  intent [--draft] [spec]  Pass 1 gate — finds cvg/docs/tech-spec-*.md\n'
  printf '                           (then docs/) when no path is given\n'
  printf '  structure [--final] [--dir d]\n'
  printf '                           Pass 2 gate — finds cvg/docs/adrs/ (then\n'
  printf '                           docs/adrs/); --final requires nothing proposed\n'
  printf '  decompose [--dir d]      Pass 3 gate — finds cvg/sketch/ (then sketch/)\n'
  printf '                           swimlane-*/ tree; CHECK_PLAN token\n'
  printf '  review --adversary E     Pass 4 dispatch — a different-family model\n'
  printf '                           (codex|kimi|claude) attacks the swimlanes headless;\n'
  printf '                           a comma-list (codex,kimi) dispatches both + merges\n'
  printf '  review [--check]         Pass 4 gate — the stamped objection log; CHECK_CONSENSUS\n'
  printf '  doctor                   engine readiness for Pass 4 dispatch (DOCTOR token)\n'
  printf '\n'
  printf '%stask lifecycle%s\n' "$UI_CYAN" "$UI_RESET"
  printf '  tasks validate <spec>    structural lint + six-tier sizing (XS/S/M/L leaf\n'
  printf '                           budgets; XL/XXL nodes need children:)\n'
  printf '  tasks gate <spec>        sign-off gate (safe-to-delegate) — refuses an\n'
  printf '                           XL/XXL node (dispatch its children, not the node)\n'
  printf '  tasks accept <spec>      acceptance after execution\n'
  printf '  tasks dod <spec>         definition-of-done + traceability matrix (DOD token)\n'
  printf '\n'
  printf '%sregister ① — into the loop%s\n' "$UI_CYAN" "$UI_RESET"
  printf '  register [--tracker github|linear|jira] [--no-stamp-refs]\n'
  printf '                           bridge signed-off tasks onto a tracker board\n'
  printf '                           (1 spec = 1 issue, depends_on → blocked-by); stamps a\n'
  printf '                           tracker_ref receipt back into each spec\n'
  printf '  register --check         gate the mapping (1:1, DAG, no orphans); read-only\n'
  printf '\n'
  printf '%squeue%s\n' "$UI_CYAN" "$UI_RESET"
  printf '  ready                    list ready-to-run tasks\n'
  printf '  lint                     lint the whole backlog (cycles, overlaps)\n'
  printf '  transition <id> <state>  move a task between statuses\n'
  printf '\n'
  printf '%sevals%s\n' "$UI_CYAN" "$UI_RESET"
  printf '  eval <spec>              run a Task-Spec'\''s own evals\n'
  printf '\n'
  printf '%ssetup%s\n' "$UI_CYAN" "$UI_RESET"
  printf '  setup                    connectivity status board (engines · trackers ·\n'
  printf '                           index · memory); records CHOICES, never keys\n'
  printf '  setup tracker <t> [--team K]\n'
  printf '                           connect + record a tracker (linear|github|jira);\n'
  printf '                           linear auto-discovers your team (export just the key)\n'
  printf '  setup repo [--branch b]  link the repo (detected from your git remote) so every\n'
  printf '                           registered issue links back to its spec\n'
  printf '\n'
  printf '%smeta%s\n' "$UI_CYAN" "$UI_RESET"
  printf '  help                     this screen\n'
  printf '  version                  cvg + wrapped toolchain versions\n'
  printf '  agent-context            machine-readable manifest (JSON): command tree,\n'
  printf '                           exit-code taxonomy, tokens, contracts (for agents)\n'
  ui_rule
  printf '%senv: CVG_HOME (repo override) · NO_COLOR / CVG_COLOR=0|1%s\n' "$UI_DIM" "$UI_RESET"
}

# ---------------------------------------------------------------------------
# Agent-native output layer (2026 SOTA): --json envelope + --dry-run on mutations
# ---------------------------------------------------------------------------
# Both are GLOBAL flags, recognized in ANY position and stripped before routing.
# The DEFAULT path is byte-parity-untouched; --json is a pure WRAPPER that
# re-invokes the command, captures its output+exit, and emits one uniform envelope
# {ok, data, error, meta}. One interception point → zero per-gate refactor, so no
# proven gate loses its behavior. --dry-run short-circuits a mutating command.

# is_mutating <cmd> [args...] — 0 if the command changes state on disk.
is_mutating() {
  local c="$1"; shift
  case "$c" in
    transition) return 0 ;;
    tasks)      [ "${1:-}" = "accept" ] && return 0 || return 1 ;;
    review)     for a in "$@"; do [ "$a" = "--adversary" ] && return 0; done; return 1 ;;
    register)   for a in "$@"; do [ "$a" = "--check" ] && return 1; done; return 0 ;;
    setup)      case "${1:-}" in tracker|repo) return 0 ;; *) return 1 ;; esac ;;
    *)          return 1 ;;
  esac
}

# cvg_envelope <cmd> <args-joined> <exit_code> <dry_run> [raw_output_file]
# Emits the uniform {ok,command,token,verdict,exit_code,changed,dry_run,data,error,
# warnings,meta} envelope. Python stdlib only (no deps). The raw output is passed via
# a FILE, not stdin — `python3 - <<'PY'` already owns stdin (the program).
cvg_envelope() {
  CVG_ENV_VERSION="$CVG_VERSION" python3 - "$1" "$2" "$3" "$4" "${5:-}" <<'PY'
import json, sys, os, re
cmd, args, rc, dry, rawfile = sys.argv[1], sys.argv[2], int(sys.argv[3]), (sys.argv[4] == "1"), sys.argv[5]
raw = open(rawfile, encoding="utf-8", errors="replace").read() if (rawfile and os.path.exists(rawfile)) else ""
token = verdict = None
for line in raw.splitlines():
    m = re.match(r'^([A-Z][A-Z0-9_]*)=([A-Za-z0-9_.|-]+)\s*$', line.strip())
    if m:
        token, verdict = line.strip(), m.group(2)   # last token wins
ok = (rc == 0)
disp, mutating = cmd, False
parts = args.split()
if cmd == "tasks":
    sub = parts[0] if parts else ""
    disp = ("tasks " + sub).strip()
    mutating = (sub == "accept")
elif cmd == "review":
    mutating = ("--adversary" in parts)
elif cmd == "transition":
    mutating = True
elif cmd == "register":
    mutating = ("--check" not in parts)
    disp = "register --check" if ("--check" in parts) else "register"
elif cmd == "setup":
    sub = parts[0] if parts else "status"
    disp = ("setup " + sub).strip() if sub != "status" else "setup"
    mutating = (sub in ("tracker", "repo"))
PASS = {"capture": 0, "intent": 1, "structure": 2, "decompose": 3, "review": 4, "doctor": 4}
env = {
    "ok": ok, "command": disp, "converge_pass": PASS.get(cmd),
    "token": token, "verdict": verdict, "exit_code": rc,
    "changed": (mutating and ok and not dry), "dry_run": dry,
    "data": {"output": raw.rstrip("\n")},
    "error": (None if ok else {"code": (verdict or "ERROR"),
              "message": (raw.strip().splitlines()[-1] if raw.strip() else "command failed")}),
    "warnings": [],
    "meta": {"schema_version": "1.0", "tool": "cvg",
             "cvg_version": os.environ.get("CVG_ENV_VERSION", "0")},
}
print(json.dumps(env, indent=2))
PY
}

# ---------------------------------------------------------------------------
# Router
# ---------------------------------------------------------------------------
CVG_JSON=0; CVG_DRY_RUN=0
_ARGS=()
for _a in "$@"; do
  case "$_a" in
    --json)    CVG_JSON=1 ;;
    --dry-run) CVG_DRY_RUN=1 ;;
    *)         _ARGS+=("$_a") ;;
  esac
done
# shellcheck disable=SC2086  # intentional: empty-array-safe re-set of positional args (bash 3.2)
set -- ${_ARGS[@]+"${_ARGS[@]}"}
CMD="${1:-help}"
[ $# -gt 0 ] && shift

# --dry-run on a MUTATING command: report the intended action, change nothing.
if [ "$CVG_DRY_RUN" -eq 1 ] && is_mutating "$CMD" "$@"; then
  if [ "$CVG_JSON" -eq 1 ]; then
    cvg_envelope "$CMD" "$*" 0 1 ""
  else
    printf 'DRY-RUN: would run: cvg %s %s — no changes made.\n' "$CMD" "$*" >&2
    printf 'DRY_RUN=OK\n'
  fi
  exit 0
fi

# --json: re-invoke the command (flags already stripped), capture output+exit,
# envelope it. agent-context/manifest are already machine-format; help/version are
# meta — all four run as-is (no envelope) since --json is stripped from their args.
if [ "$CVG_JSON" -eq 1 ]; then
  case "$CMD" in
    agent-context|manifest|help|--help|-h|version|--version|-v) : ;;
    *)
      _J_RC=0
      _J_TMP="$(mktemp)"
      bash "$0" "$CMD" "$@" > "$_J_TMP" 2>&1 || _J_RC=$?   # || : a failing gate must not abort set -e
      cvg_envelope "$CMD" "$*" "$_J_RC" 0 "$_J_TMP"
      rm -f "$_J_TMP"
      exit "$_J_RC"
      ;;
  esac
fi

case "$CMD" in
  help|--help|-h)
    CVG_HOME_DIR="(unresolved)"
    cmd_help
    exit 0
    ;;
esac

CVG_HOME_DIR="$(resolve_home)" || exit 1
SCRIPTS="$CVG_HOME_DIR/skills/task-spec/scripts"

case "$CMD" in
  tasks)
    SUB="${1:-}"
    [ $# -gt 0 ] && shift
    case "$SUB" in
      validate) route validate-task-spec.sh "$@" ;;
      gate)     route safe-to-delegate.sh "$@" ;;
      accept)   route accept-task.sh "$@" ;;
      dod)      route definition-of-done.sh "$@" ;;
      *)
        ui_err "unknown tasks subcommand '${SUB:-}' — expected: validate | gate | accept | dod"
        exit 2
        ;;
    esac
    ;;
  capture)
    # Pass 0 gate: locate the brief, route to the idea-to-brd exit contract.
    # Gate path is an exact pass-through (exec, zero decoration) — R0.P
    # proves by byte-diff. Discovery messages exist ONLY on the exit-2 path,
    # and every exit-2 path still ends in the CHECK_BRD=USAGE_ERROR token
    # (agents are users — never make a harness parse prose).
    GATE="$CVG_HOME_DIR/skills/idea-to-brd/scripts/check-brd.sh"
    CAP_FLAGS=""
    CAP_TARGET=""
    CAP_KIND="brd"
    CAP_DRAFT=0
    CAP_NOGO=0
    for A in "$@"; do
      case "$A" in
        --draft) CAP_FLAGS="$CAP_FLAGS --draft"; CAP_DRAFT=1 ;;
        --no-go) CAP_FLAGS="$CAP_FLAGS --no-go"; CAP_NOGO=1; CAP_KIND="no-go" ;;
        -*)
          ui_err "unknown capture flag '$A' — expected --draft or --no-go"
          printf 'CHECK_BRD=USAGE_ERROR\n'
          exit 2
          ;;
        *)       CAP_TARGET="$A" ;;
      esac
    done
    if [ "$CAP_DRAFT" -eq 1 ] && [ "$CAP_NOGO" -eq 1 ]; then
      ui_err "--draft and --no-go conflict — a record is a BRD draft or a no-go, never both"
      printf 'CHECK_BRD=USAGE_ERROR\n'
      exit 2
    fi
    if [ -z "$CAP_TARGET" ]; then
      CAP_N=0
      CAP_LIST=""
      for F in "cvg/docs/${CAP_KIND}-"*.md "docs/${CAP_KIND}-"*.md; do
        [ -f "$F" ] || continue
        CAP_N=$((CAP_N + 1))
        CAP_TARGET="$F"
        CAP_LIST="${CAP_LIST}  ${F}
"
      done
      if [ "$CAP_N" -eq 0 ]; then
        ui_err "no ${CAP_KIND}-*.md found under cvg/docs/ or docs/ from '$PWD' — pass the file: cvg capture [--draft|--no-go] <file>"
        printf 'CHECK_BRD=USAGE_ERROR\n'
        exit 2
      fi
      if [ "$CAP_N" -gt 1 ]; then
        ui_err "ambiguous: $CAP_N ${CAP_KIND} documents found — pass one explicitly:"
        printf '%s' "$CAP_LIST" >&2
        printf 'CHECK_BRD=USAGE_ERROR\n'
        exit 2
      fi
    fi
    # shellcheck disable=SC2086  # CAP_FLAGS is a controlled flag list (--draft/--no-go only)
    exec bash "$GATE" $CAP_FLAGS "$CAP_TARGET"
    ;;
  intent)
    # Pass 1 gate: locate the tech-spec, route to the brd-docs-to-tech-req
    # exit contract. Gate path is an exact pass-through (exec, zero
    # decoration) — R1.P proves by byte-diff. Discovery/flag errors exist
    # ONLY on the exit-2 path and still end in the machine token.
    GATE="$CVG_HOME_DIR/skills/brd-docs-to-tech-req/scripts/check-tech-spec.sh"
    INT_FLAGS=""
    INT_TARGET=""
    for A in "$@"; do
      case "$A" in
        --draft) INT_FLAGS="$INT_FLAGS --draft" ;;
        -*)
          ui_err "unknown intent flag '$A' — expected --draft"
          printf 'CHECK_TECH_SPEC=USAGE_ERROR\n'
          exit 2
          ;;
        *)       INT_TARGET="$A" ;;
      esac
    done
    if [ -z "$INT_TARGET" ]; then
      INT_N=0
      INT_LIST=""
      for F in cvg/docs/tech-spec-*.md docs/tech-spec-*.md; do
        [ -f "$F" ] || continue
        INT_N=$((INT_N + 1))
        INT_TARGET="$F"
        INT_LIST="${INT_LIST}  ${F}
"
      done
      if [ "$INT_N" -eq 0 ]; then
        ui_err "no tech-spec-*.md found under cvg/docs/ or docs/ from '$PWD' — pass the file: cvg intent [--draft] <file>"
        printf 'CHECK_TECH_SPEC=USAGE_ERROR\n'
        exit 2
      fi
      if [ "$INT_N" -gt 1 ]; then
        ui_err "ambiguous: $INT_N tech-spec documents found — pass one explicitly:"
        printf '%s' "$INT_LIST" >&2
        printf 'CHECK_TECH_SPEC=USAGE_ERROR\n'
        exit 2
      fi
    fi
    # shellcheck disable=SC2086  # INT_FLAGS is a controlled flag list (--draft only)
    exec bash "$GATE" $INT_FLAGS "$INT_TARGET"
    ;;
  structure)
    # Pass 2 gate: locate the ADR set, route to the tech-req-to-adrs checker.
    # Gate path is an exact pass-through (exec, zero decoration) — R2.P proves
    # by byte-diff. Discovery/flag errors exist ONLY on the exit-2 path and
    # still end in the machine token CHECK_ADR=USAGE_ERROR (agents are users).
    GATE="$CVG_HOME_DIR/skills/tech-req-to-adrs/scripts/scaffold-adr.sh"
    STR_FLAGS=""
    STR_DIR=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --final) STR_FLAGS="$STR_FLAGS --final"; shift ;;
        --dir)
          if [ $# -lt 2 ]; then
            ui_err "--dir needs a path — cvg structure [--final] --dir <adr-dir>"
            printf 'CHECK_ADR=USAGE_ERROR\n'
            exit 2
          fi
          STR_DIR="$2"; shift 2 ;;
        --dir=*) STR_DIR="${1#--dir=}"; shift ;;
        -*)
          ui_err "unknown structure flag '$1' — expected --final or --dir <path>"
          printf 'CHECK_ADR=USAGE_ERROR\n'
          exit 2 ;;
        *)       STR_DIR="$1"; shift ;;
      esac
    done
    if [ -z "$STR_DIR" ]; then
      STR_N=0
      STR_LIST=""
      for D in cvg/docs/adrs docs/adrs; do
        [ -d "$D" ] || continue
        ls "$D"/[0-9][0-9][0-9][0-9]-*.md >/dev/null 2>&1 || continue
        STR_N=$((STR_N + 1))
        STR_DIR="$D"
        STR_LIST="${STR_LIST}  ${D}
"
      done
      if [ "$STR_N" -eq 0 ]; then
        ui_err "no ADR set (docs/adrs/ with NNNN-*.md) found under cvg/docs/ or docs/ from '$PWD' — pass it: cvg structure [--final] --dir <adr-dir>"
        printf 'CHECK_ADR=USAGE_ERROR\n'
        exit 2
      fi
      if [ "$STR_N" -gt 1 ]; then
        ui_err "ambiguous: $STR_N ADR directories found — pass one explicitly:"
        printf '%s' "$STR_LIST" >&2
        printf 'CHECK_ADR=USAGE_ERROR\n'
        exit 2
      fi
    fi
    # shellcheck disable=SC2086  # STR_FLAGS is a controlled flag list (--final only)
    exec bash "$GATE" --check $STR_FLAGS --dir "$STR_DIR"
    ;;
  decompose)
    # Pass 3 gate: locate the sketch/ tree, route to the reqs-to-swimlane-plans
    # checker. Exact exec pass-through (R3.P proves by byte-diff). Discovery/flag
    # errors exist ONLY on the exit-2 path and end in CHECK_PLAN=USAGE_ERROR.
    GATE="$CVG_HOME_DIR/skills/reqs-to-swimlane-plans/scripts/new-plan.sh"
    DEC_DIR=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --dir)
          if [ $# -lt 2 ]; then
            ui_err "--dir needs a path — cvg decompose --dir <sketch-dir>"
            printf 'CHECK_PLAN=USAGE_ERROR\n'
            exit 2
          fi
          DEC_DIR="$2"; shift 2 ;;
        --dir=*) DEC_DIR="${1#--dir=}"; shift ;;
        -*)
          ui_err "unknown decompose flag '$1' — expected --dir <path>"
          printf 'CHECK_PLAN=USAGE_ERROR\n'
          exit 2 ;;
        *)       DEC_DIR="$1"; shift ;;
      esac
    done
    if [ -z "$DEC_DIR" ]; then
      DEC_N=0
      DEC_LIST=""
      for D in cvg/sketch sketch; do
        [ -d "$D" ] || continue
        ls -d "$D"/swimlane-*/ >/dev/null 2>&1 || continue
        DEC_N=$((DEC_N + 1))
        DEC_DIR="$D"
        DEC_LIST="${DEC_LIST}  ${D}
"
      done
      if [ "$DEC_N" -eq 0 ]; then
        ui_err "no swimlane set (sketch/swimlane-*/) found under cvg/ or . from '$PWD' — pass it: cvg decompose --dir <sketch-dir>"
        printf 'CHECK_PLAN=USAGE_ERROR\n'
        exit 2
      fi
      if [ "$DEC_N" -gt 1 ]; then
        ui_err "ambiguous: $DEC_N sketch trees found — pass one explicitly:"
        printf '%s' "$DEC_LIST" >&2
        printf 'CHECK_PLAN=USAGE_ERROR\n'
        exit 2
      fi
    fi
    exec bash "$GATE" --check --dir "$DEC_DIR"
    ;;
  review)
    # Pass 4 · Consensus. Two modes:
    #   cvg review --adversary codex|kimi|claude   dispatch a headless adversary
    #   cvg review [--check]                        gate the stamped objection log
    # The referee frames + dispatches + gates; it never calls an LLM (the engine
    # CLI authenticates itself). Discovery mirrors decompose.
    GATE="$CVG_HOME_DIR/skills/sketch-plans-adversarial-review/scripts/check-consensus-gate.sh"
    DISPATCH="$CVG_HOME_DIR/skills/sketch-plans-adversarial-review/scripts/dispatch-review.sh"
    DISPATCH_MULTI="$CVG_HOME_DIR/skills/sketch-plans-adversarial-review/scripts/dispatch-review-multi.sh"
    REV_MODE="check"; REV_ADV=""; REV_DIR=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --check)     REV_MODE="check"; shift ;;
        --adversary) REV_MODE="dispatch"; REV_ADV="${2:-}"; shift 2 ;;
        --dir)       REV_DIR="${2:-}"; shift 2 ;;
        --dir=*)     REV_DIR="${1#--dir=}"; shift ;;
        -*)          ui_err "unknown review flag '$1' — expected --check or --adversary <e> [--dir <sketch>]"
                     printf 'CHECK_CONSENSUS=USAGE_ERROR\n'; exit 2 ;;
        *)           REV_DIR="$1"; shift ;;
      esac
    done
    if [ -z "$REV_DIR" ]; then
      REV_N=0
      for D in cvg/sketch sketch; do
        [ -d "$D" ] || continue
        ls -d "$D"/swimlane-*/ >/dev/null 2>&1 || continue
        REV_N=$((REV_N + 1)); REV_DIR="$D"
      done
      if [ "$REV_N" -ne 1 ]; then
        ui_err "no unique swimlane tree (sketch/swimlane-*/) under cvg/ or . from '$PWD' — pass --dir <sketch>"
        printf 'CHECK_CONSENSUS=USAGE_ERROR\n'; exit 2
      fi
    fi
    if [ "$REV_MODE" = "dispatch" ]; then
      case "$REV_ADV" in
        *,*) exec bash "$DISPATCH_MULTI" --adversary "$REV_ADV" --dir "$REV_DIR" ;;
        *)   exec bash "$DISPATCH" --adversary "$REV_ADV" --dir "$REV_DIR" ;;
      esac
    else
      exec bash "$GATE" --dir "$REV_DIR"
    fi
    ;;
  doctor)
    exec bash "$CVG_HOME_DIR/skills/sketch-plans-adversarial-review/scripts/doctor.sh"
    ;;
  register)
    # REGISTER ① — bridge signed-off Task-Specs onto a tracker board (Fork B → the Loop).
    #   cvg register [--tracker T] [--tasks-dir D] [--no-stamp-refs]   write the board (mutating)
    #   cvg register --check [--tracker T] [--tasks-dir D] [--prune]   gate the mapping (read-only)
    # The referee frames + drives the pluggable adapter (github|linear|jira); it
    # holds NO tracker credentials — the adapter authenticates itself, exactly as
    # the Pass-4 engine CLIs do. --dry-run (global) reports intent and changes
    # nothing; for the rich OFFLINE preview (cycles, DAG, edge integrity) use
    # --check, which maps cvg's --dry-run to the verifier's spec-side-only gate.
    REG="$CVG_HOME_DIR/skills/task-specs-to-issues/scripts/register.sh"
    REGVERIFY="$CVG_HOME_DIR/skills/task-specs-to-issues/scripts/verify-registration.sh"
    [ -f "$REG" ] || { ui_err "register driver not found: $REG"; exit 2; }
    REG_CHECK=0
    REG_PASS=()
    for A in "$@"; do
      case "$A" in
        --check) REG_CHECK=1 ;;
        *)       REG_PASS+=("$A") ;;
      esac
    done
    # Default --tracker from .cvg/config when the caller didn't specify one
    # (setup configures; the passes consume). An explicit --tracker always wins.
    REG_HAS_TRACKER=0
    if [ "${#REG_PASS[@]}" -gt 0 ]; then
      for A in "${REG_PASS[@]}"; do
        case "$A" in --tracker|--tracker=*) REG_HAS_TRACKER=1 ;; esac
      done
    fi
    if [ "$REG_HAS_TRACKER" -eq 0 ]; then
      CFG_TRACKER="$(cvg_config_get tracker)"
      if [ -n "$CFG_TRACKER" ]; then
        REG_PASS=(--tracker "$CFG_TRACKER" ${REG_PASS[@]+"${REG_PASS[@]}"})
        printf '%susing configured tracker: %s (from .cvg/config)%s\n' "$UI_DIM" "$CFG_TRACKER" "$UI_RESET" >&2
      fi
    fi
    cvg_export_linear_team   # bridge the non-secret Linear team UUID from config (key stays in env)
    cvg_export_spec_base     # bridge the repo base URL so issues link back to their spec
    if [ "$REG_CHECK" -eq 1 ]; then
      # Read-only gate. cvg strips --dry-run into CVG_DRY_RUN; re-add it as the
      # verifier's spec-side-only flag so `cvg register --check --dry-run` is offline.
      [ "$CVG_DRY_RUN" -eq 1 ] && REG_PASS+=(--dry-run)
      exec bash "$REGVERIFY" ${REG_PASS[@]+"${REG_PASS[@]}"}
    else
      exec bash "$REG" ${REG_PASS[@]+"${REG_PASS[@]}"}
    fi
    ;;
  setup)
    # SETUP — the guided connectivity surface. `cvg setup` scans every moving part
    # (engines · trackers · [index · memory, planned]) and reports readiness + the
    # exact next step. `cvg setup tracker <t>` validates a backend (adapter
    # preflight) and records the CHOICE in .cvg/config. Referee-safe: records
    # choices, NEVER credentials — secrets resolve at runtime from the environment.
    SUB="${1:-status}"
    [ $# -gt 0 ] && shift
    case "$SUB" in
      status)  cvg_setup_status "$@" ;;
      tracker) cvg_setup_tracker "$@" ;;
      repo)    cvg_setup_repo "$@" ;;
      engines) exec bash "$CVG_HOME_DIR/skills/sketch-plans-adversarial-review/scripts/doctor.sh" ;;
      *)       ui_err "unknown setup part '$SUB' — expected: status | tracker <t> | repo | engines"
               printf 'SETUP=USAGE_ERROR\n'; exit 2 ;;
    esac
    ;;
  eval)       route run-task-spec.sh "$@" ;;
  lint)       route lint-backlog.sh "$@" ;;
  transition) route transition-status.sh "$@" ;;
  ready)      route list-ready.sh "$@" ;;
  version|--version|-v)
    cmd_version
    exit 0
    ;;
  agent-context|manifest)
    # Machine-readable self-description (agent-native CLI SOTA — clispec.dev /
    # cli-agent-spec, 2026): the full command tree + exit-code taxonomy
    # (retryable / side_effects) + the token each command emits + the global
    # contracts, versioned. ONE call replaces N `help` iterations for an agent.
    # Emits a single JSON document to stdout. Python is stdlib-only (no deps).
    CVG_MF_VERSION="$CVG_VERSION" exec python3 - <<'PY'
import json, os
v = os.environ.get("CVG_MF_VERSION", "0")
def c(name, p, wraps, tokens, mutating, example, desc):
    return {"name": name, "converge_pass": p, "wraps": wraps,
            "emits_tokens": tokens, "mutating": mutating, "example": example, "description": desc}
m = {
  "schema_version": "1.0", "tool": "cvg", "version": v, "role": "referee",
  "description": "Referee CLI for the Converge 8-pass method. Never a player: zero model credentials, no LLM calls. It frames prompts, dispatches engine CLIs headlessly, and gates their output; wrapped gates are byte-exact pass-throughs (exec).",
  "contracts": {
    "stdout": "results + wrapped-gate output (parse-stable; no ANSI when piped)",
    "stderr": "diagnostics + progress only",
    "token": "every gate/verdict surface ends in ONE stable greppable token on its own final line (e.g. CHECK_BRD=PASS)",
    "color": "TTY-only; NO_COLOR (non-empty) or CVG_COLOR=0 disable; color never carries meaning alone",
    "determinism": "gate commands are read-only, idempotent, byte-parity pass-throughs to the wrapped script",
    "resolution": "CVG_HOME wins when set; else walk up from cwd to the first repo carrying skills/task-spec/scripts/"
  },
  "global_flags": [
    {"flag": "--json", "position": "any", "effect": "emit a uniform response envelope {ok, command, token, verdict, exit_code, changed, dry_run, data, error, warnings, meta{schema_version, tool, cvg_version}} as ONE JSON document on stdout, instead of prose. The underlying exit code is preserved. agent-context/help/version are unaffected (already machine/meta)."},
    {"flag": "--dry-run", "position": "any", "applies_to": "mutating commands only (review --adversary, tasks accept, transition, register)", "effect": "report the intended action and change nothing; envelope carries changed=false, dry_run=true (token DRY_RUN=OK in text mode). For register, the rich offline preview (cycles, DAG, edge integrity) is `register --check`."}
  ],
  "exit_codes": [
    {"code": 0,  "name": "OK",           "meaning": "gate passed / command succeeded",                              "retryable": False, "side_effects": "none"},
    {"code": 1,  "name": "GATE_FAIL",    "meaning": "the gate failed (verdict RED); the artifact is not acceptable", "retryable": False, "side_effects": "none"},
    {"code": 2,  "name": "USAGE_ERROR",  "meaning": "bad/unknown flag, no unique discovery target, or nothing to gate", "retryable": False, "side_effects": "none"},
    {"code": 20, "name": "SKIP",         "meaning": "dispatch: the requested engine is not installed",               "retryable": True,  "side_effects": "none"},
    {"code": 21, "name": "TIMEOUT",      "meaning": "dispatch: engine exceeded the wall-clock cap (fail-closed)",    "retryable": True,  "side_effects": "none"},
    {"code": 22, "name": "ENGINE_ERROR", "meaning": "dispatch: engine produced no parseable judgment (fail-closed)", "retryable": True,  "side_effects": "none"}
  ],
  "commands": [
    c("capture", 0, "idea-to-brd/check-brd.sh", ["CHECK_BRD=PASS|FAIL|USAGE_ERROR"], False, "cvg capture", "Pass 0 gate — the BRD exit contract."),
    c("intent", 1, "brd-docs-to-tech-req/check-tech-spec.sh", ["CHECK_TECH_SPEC=PASS|FAIL|USAGE_ERROR"], False, "cvg intent", "Pass 1 gate — the tech-spec exit contract."),
    c("structure", 2, "tech-req-to-adrs/scaffold-adr.sh --check", ["CHECK_ADR=OK|FAIL|USAGE_ERROR"], False, "cvg structure", "Pass 2 gate — the ADR set."),
    c("decompose", 3, "reqs-to-swimlane-plans/new-plan.sh --check", ["CHECK_PLAN=OK|FAIL|USAGE_ERROR"], False, "cvg decompose", "Pass 3 gate — the swimlane tree."),
    c("review --adversary <e[,e]>", 4, "sketch-plans-adversarial-review/dispatch-review[-multi].sh", ["REVIEW=OK|ERROR|SKIP|TIMEOUT|USAGE_ERROR"], True, "cvg review --adversary codex,kimi", "Pass 4 dispatch — a different-family adversary (or several, merged) attacks the plans; writes a provenance-stamped objection log."),
    c("review --check", 4, "sketch-plans-adversarial-review/check-consensus-gate.sh", ["CHECK_CONSENSUS=OK|FAIL|EMPTY|USAGE_ERROR"], False, "cvg review --check", "Pass 4 gate — validates the stamped objection log (cross-family, resolutions, fork B, provenance)."),
    c("doctor", 4, "sketch-plans-adversarial-review/doctor.sh", ["DOCTOR=OK|FAIL"], False, "cvg doctor", "Engine readiness for Pass 4 dispatch (>=2 engines, >=1 cross-family)."),
    c("tasks validate <spec>", "5B", "task-spec/validate-task-spec.sh", ["OK / FAIL (structural + six-tier sizing)"], False, "cvg tasks validate T-...md", "Structural lint + six-tier effort gate (leaf write-surface budgets; XL/XXL nodes need children)."),
    c("tasks gate <spec>", "5B", "task-spec/safe-to-delegate.sh", ["VERDICT: DELEGATE|DO NOT DELEGATE", "TIER=1|2|3"], False, "cvg tasks gate T-...md", "Sign-off gate; refuses an XL/XXL node (dispatch its children, not the node)."),
    c("tasks accept <spec>", "5B", "task-spec/accept-task.sh", ["ACCEPT / REJECT"], True, "cvg tasks accept T-...md --stamp", "Post-execution acceptance."),
    c("tasks dod <spec>", "5B", "task-spec/definition-of-done.sh", ["DOD=COMPLETE|GAPS|USAGE_ERROR"], False, "cvg tasks dod T-...md", "Definition-of-Done + traceability matrix (every behavior B-N → its verifying eval); gates DOD=GAPS if a behavior is untraced. The 2026 agent-spec SOTA review artifact."),
    c("register [--tracker T] [--no-stamp-refs]", "①", "task-specs-to-issues/register.sh", ["REGISTER=OK|FAIL|DRY_RUN|EMPTY"], True, "cvg register --tracker linear", "REGISTER ① — bridge signed-off Task-Specs onto a tracker board (1 spec = 1 issue, depends_on → blocked-by), then stamp a tracker_ref receipt back into each spec. Pluggable adapter github|linear|jira (default linear); the referee holds NO tracker credentials. Idempotent: re-runs upsert, never duplicate. --no-stamp-refs skips the write-back (CI-safe; the issue-side marker stays the key)."),
    c("register --check", "①", "task-specs-to-issues/verify-registration.sh", ["CHECK_REGISTER=OK|FAIL"], False, "cvg register --check --tracker linear", "Gate the mapping is faithful: 1:1 count, every depends_on edge is one blocked-by link, no cycle, no un-gated leak. Read-only; the offline spec-side half runs with --dry-run."),
    c("setup", None, "native (doctor + adapter preflight)", ["SETUP=READY|INCOMPLETE"], False, "cvg setup", "Connectivity status board — per-part readiness (engines · trackers; index/memory planned) + the exact next step. Records CHOICES in .cvg/config, NEVER credentials (secrets stay in the environment / a secrets manager — if cvg can't see them it can't leak them)."),
    c("setup tracker <t> [--team K]", None, "native (+ adapter preflight)", ["SETUP_TRACKER=OK|NEEDS_TEAM|UNREACHABLE|USAGE_ERROR"], True, "cvg setup tracker linear", "Validate a tracker via preflight and record it as the default in .cvg/config; cvg register then defaults --tracker from it. For linear: export only LINEAR_API_KEY — the team is auto-discovered (a single team auto-selects; otherwise pass --team <KEY>, the key straight from the Linear URL), resolved to a UUID, and recorded. The API key is never stored."),
    c("setup repo [--branch b] [--url u]", None, "native (git remote)", ["SETUP_REPO=OK|UNDETECTED|USAGE_ERROR"], True, "cvg setup repo", "Link the repo to the tracker: derives a browsable blob base URL from the git remote (github/gitlab/bitbucket shapes) and records it as spec_base_url in .cvg/config, so every registered issue links back to the spec it was projected from. Branch-pinned; --branch/--url override."),
    c("eval <spec>", "5B", "task-spec/run-task-spec.sh", ["per-eval pass/fail"], False, "cvg eval T-...md", "Run a Task-Spec's evals."),
    c("lint", "5B", "task-spec/lint-backlog.sh", ["backlog issues"], False, "cvg lint", "Lint the backlog for overlaps/cycles."),
    c("transition <id> <state>", "5B", "task-spec/transition-status.sh", ["status change"], True, "cvg transition T-...md done", "Move a task between statuses (locked + logged)."),
    c("ready", "5B", "task-spec/list-ready.sh", ["ready task list"], False, "cvg ready", "List ready-to-run tasks."),
    c("help", None, "native", [], False, "cvg help", "Human-readable command map."),
    c("version", None, "native", ["cvg <semver>"], False, "cvg version", "Print the version."),
    c("agent-context", None, "native", ["this JSON document"], False, "cvg agent-context", "This machine-readable manifest (also: cvg manifest).")
  ]
}
print(json.dumps(m, indent=2))
PY
    ;;
  *)
    ui_err "unknown command '$CMD' — run 'cvg help' for the command map"
    exit 2
    ;;
esac
