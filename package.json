{
  "name": "@luanmorenommaciel/converge",
  "version": "0.1.0",
  "description": "Compile intent into shipped software — the dark factory for coding agents. Nine gated passes, twelve portable skills, and the cvg referee CLI (bash 3.2+, zero runtime dependencies); done is proven by runnable evals, never claimed.",
  "bin": {
    "cvg": "bin/cvg",
    "cvg-install": "install.sh"
  },
  "scripts": {
    "control-room:install": "npm --prefix apps/control-room install",
    "control-room:dev": "npm --prefix apps/control-room run dev --",
    "control-room:build": "npm --prefix apps/control-room run build",
    "control-room:check": "npm --prefix apps/control-room run check",
    "control-room:start": "npm --prefix apps/control-room run start --"
  },
  "files": [
    "bin/",
    "skills/",
    "install.sh",
    "VERSION",
    ".claude-plugin/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luanmorenommaciel/converge.git"
  },
  "homepage": "https://github.com/luanmorenommaciel/converge#readme",
  "bugs": "https://github.com/luanmorenommaciel/converge/issues",
  "keywords": [
    "agentic",
    "task-spec",
    "evals",
    "delivery",
    "referee",
    "claude-code",
    "codex",
    "kimi",
    "grok"
  ],
  "author": "Luan Moreno M. Maciel",
  "license": "MIT"
}
