{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://converge.dev/contracts/ui/v1/workspace-snapshot.schema.json",
  "title": "Converge Control Room Workspace Snapshot",
  "type": "object",
  "required": [
    "schemaVersion",
    "snapshotId",
    "generatedAt",
    "source",
    "project",
    "cli",
    "method",
    "review",
    "authorization",
    "activity",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "snapshotId": {
      "type": "string",
      "minLength": 12
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "enum": ["live", "fixture"]
    },
    "project": {
      "type": "object",
      "required": ["name", "root", "lane", "branch", "commit", "dirty"],
      "properties": {
        "name": { "type": "string" },
        "root": { "type": "string" },
        "lane": { "enum": ["FULL", "NORMAL", "FAST"] },
        "branch": { "type": "string" },
        "commit": { "type": "string" },
        "dirty": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "cli": {
      "type": "object",
      "required": ["version", "role", "commandCount"],
      "properties": {
        "version": { "type": "string" },
        "role": { "type": "string" },
        "commandCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "required": ["name", "version", "activePassId", "passes", "edges"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "activePassId": { "type": "string" },
        "passes": {
          "type": "array",
          "items": { "$ref": "#/$defs/pass" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/edge" }
        }
      },
      "additionalProperties": false
    },
    "review": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["round", "verdict", "adversary", "objections", "openQuestions"],
          "properties": {
            "round": { "type": "integer", "minimum": 0 },
            "verdict": { "type": "string" },
            "adversary": {
              "type": "object",
              "required": ["engine", "family"],
              "properties": {
                "engine": { "type": "string" },
                "family": { "type": "string" },
                "version": { "type": "string" }
              },
              "additionalProperties": false
            },
            "authorFamily": { "type": "string" },
            "objections": {
              "type": "array",
              "items": { "$ref": "#/$defs/objection" }
            },
            "openQuestions": {
              "type": "array",
              "items": { "$ref": "#/$defs/question" }
            },
            "promptSha256": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "authorization": {
      "type": "object",
      "required": ["state", "nextPassId", "command", "rationale"],
      "properties": {
        "state": { "enum": ["allowed", "blocked", "attention", "unknown"] },
        "nextPassId": { "type": ["string", "null"] },
        "command": { "type": ["string", "null"] },
        "rationale": { "type": "string" }
      },
      "additionalProperties": false
    },
    "activity": {
      "type": "array",
      "items": { "$ref": "#/$defs/activity" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "required": ["command", "token", "verdict", "exitCode", "ok"],
      "properties": {
        "command": { "type": "string" },
        "token": { "type": ["string", "null"] },
        "verdict": { "type": ["string", "null"] },
        "exitCode": { "type": ["integer", "null"] },
        "ok": { "type": ["boolean", "null"] }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["id", "label", "path", "kind"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "path": { "type": "string" },
        "kind": { "type": "string" },
        "sha256": { "type": "string" }
      },
      "additionalProperties": false
    },
    "pass": {
      "type": "object",
      "required": [
        "id",
        "order",
        "label",
        "shortLabel",
        "summary",
        "status",
        "gate",
        "evidence",
        "blockerCount",
        "position"
      ],
      "properties": {
        "id": { "type": "string" },
        "order": { "type": "integer" },
        "label": { "type": "string" },
        "shortLabel": { "type": "string" },
        "summary": { "type": "string" },
        "status": {
          "enum": [
            "complete",
            "active",
            "attention",
            "blocked",
            "waiting",
            "optional",
            "skipped"
          ]
        },
        "optional": { "type": "boolean" },
        "gate": { "$ref": "#/$defs/gate" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "blockerCount": { "type": "integer", "minimum": 0 },
        "position": {
          "type": "object",
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["id", "source", "target", "kind"],
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string" },
        "target": { "type": "string" },
        "kind": {
          "enum": ["complete", "active", "waiting", "optional", "return"]
        },
        "label": { "type": "string" }
      },
      "additionalProperties": false
    },
    "objection": {
      "type": "object",
      "required": ["id", "title", "severity"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "severity": { "type": "string" },
        "confidence": { "type": "number" },
        "body": { "type": "string" },
        "disposition": { "type": "string" },
        "residualRisk": { "type": "string" },
        "planPath": { "type": "string" }
      },
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "required": ["question", "owner", "blocksBuild"],
      "properties": {
        "question": { "type": "string" },
        "owner": { "type": "string" },
        "blocksBuild": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "activity": {
      "type": "object",
      "required": ["id", "time", "label", "detail", "tone", "source"],
      "properties": {
        "id": { "type": "string" },
        "passId": { "type": "string" },
        "time": { "type": "string" },
        "label": { "type": "string" },
        "detail": { "type": "string" },
        "tone": {
          "enum": ["proven", "active", "attention", "neutral"]
        },
        "source": {
          "enum": ["gate", "git", "artifact", "fixture"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
