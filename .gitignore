# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# OS
.DS_Store

# Editor
*.swp

# Converge runtime artifacts (derived from frontmatter/git — never committed)
tasks/_state.yaml
_fleet.jsonl

# Pass 8 loop scratch. Each attempt writes a brief, a transcript and a durable
# checkpoint under cvg/loop/<task-id>/ so a crashed run can resume and a human
# can read what happened — but they are per-run state, not evidence, and an
# engine transcript is exactly the kind of file that quietly carries a key.
# HANDOFF.md is deliberately NOT ignored: it is the planned landing a human
# picks up.
# The `**/` prefix is load-bearing: a pattern containing a slash is anchored to
# this file's directory, so a root-anchored `cvg/loop/...` would silently miss
# every workspace that is not the repo root — including the proving ground at
# tests/uc-analytics/cvg/, which is the layout these patterns exist for.
**/cvg/loop/*/state.env
**/cvg/loop/*/STOP
**/cvg/loop/*/brief-*.md
**/cvg/loop/*/attempts/

# Build artifacts
dist/

# Scratch page-render artifacts (spine PDF build leftovers — kept on disk, out of git)
temp/spine-*
temp/v3-*
temp/cvg-spine-*
temp/fig*.html
temp/genfig*.py
temp/*.png
temp/legs-e2e/

# Engine session scratch (kimi/codex run dirs)
.kimi/

# task-specs-to-issues fake adapter test store (no-network)
.tsi-fake-store/

# cvg local setup state — tracker choice + the workspace's team UUID, written by
# `cvg setup`. Not secret (cvg never stores credentials), but workspace-specific:
# each user runs `cvg setup` for their own board rather than inheriting yours.
.cvg/

# scratch render output (deck PDFs, intermediates)
tmp/

# Local tool scratch — never part of the method
.ruff_cache/
.sc/

# graphify — local developer tooling, not part of the shipped method. The
# knowledge graph is a derived artifact, and `.claude/settings.json` pins an
# absolute path to this machine's graphify binary, so neither travels.
# NOTE: CLAUDE.md here is entirely graphify-generated. Delete that line below
# the day you author a real project CLAUDE.md, or it will be silently ignored.
graphify-out/
.claude/
CLAUDE.md
