{
  "name": "@converge/control-room",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Read-only cinematic lineage interface for a local Converge workspace.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "check": "tsc -b && node --test server/*.test.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/index.mjs --serve-dist"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@xyflow/react": "12.11.2",
    "motion": "12.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
